# GROQ_API_KEY: Required for Groq Chat Completions API calls (server-side only).
# Never expose this variable to client-side bundles or frontend code.
GROQ_API_KEY="MY_GROQ_API_KEY"

# LLM Query Understanding settings (server-side only)
ENABLE_LLM_QUERY_PARSE="true"
GROQ_MODEL="llama-3.1-8b-instant"
LLM_TIMEOUT_MS="6000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_USE_MOCK: Set to "true" to use local mock services, or "false" to connect to real backend API endpoints.
VITE_USE_MOCK="true"

# VITE_API_BASE_URL: Base URL for real API requests when VITE_USE_MOCK is false.
VITE_API_BASE_URL="/api"
